generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    CLIENT
    DEVELOPER
    PRODUCTMANAGER
    ADMIN
}

enum Currency {
    USD
    INR
    NPR
}

enum TaskStatus {
    YET_TO_START
    IN_PROGRESS
    COMPLETED
}

enum Status {
    IN_PROGRESS
    COMPLETED
    ON_HOLD
    CANCELLED
}

enum ClientType {
    INTERNAL
    EXTERNAL
}

enum FeedbackStatus {
    PENDING
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum ReferralCodeStatus {
    ACTIVE
    USED
    EXPIRED
    DISABLED
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    DECLINED
    EXPIRED
}

enum InvitationType {
    COMPANY_MEMBER
    PROJECT_MEMBER
}

enum UserRole {
    BASIC_DEVELOPER      // Basic access - can view projects, tasks
    PROJECT_CREATOR      // Can create projects, onboard clients
    SENIOR_DEVELOPER     // Full development access
    TEAM_LEAD           // Team management access
}

enum NotificationType {
    PROJECT_ASSIGNED
    TASK_ASSIGNED
    TASK_COMPLETED
    PROJECT_UPDATE
    USER_PROMOTED
    CLIENT_ONBOARDED
    FEEDBACK_RECEIVED
    MENTION
    GENERAL
}

model User {
    id                String    @id @default(cuid())
    name              String?
    email             String?   @unique
    emailVerified     DateTime?
    hashedPassword    String?
    image             String?
    bio               String?   @db.Text
    skills            String?   @db.Text
    role              Role      @default(CLIENT)
    userRole          UserRole? // Additional role for developers (only for DEVELOPER role)
    verifyToken       String?
    verifyTokenExpiry DateTime?
    resetToken        String?
    resetTokenExpiry  DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    totalSpent        Float     @default(0)

    // Company-related fields
    companyId      String?
    company        Company? @relation("CompanyUsers", fields: [companyId], references: [id])
    companyEmail   String? // Optional company email for PM role
    referralCode   String? // The referral code used during registration
    managedCompany Company? @relation("CompanyManager")

    // Referral relationships
    generatedReferralCodes ReferralCode[] @relation("GeneratedBy")
    usedReferralCodeId     String?
    usedReferralCode       ReferralCode?  @relation("UsedBy", fields: [usedReferralCodeId], references: [id])

    // Relations
    projects            Project[]
    accounts            Account[]
    sessions            Session[]
    managedTeam         Team?           @relation("TeamLead")
    memberOfTeams       Team[]          @relation("TeamMembers")
    assignedTasks       Task[]          @relation("AssignedDeveloper")
    feedbacks           Feedback[]
    messages            Message[]

    // Invitations
    sentInvitations     Invitation[]    @relation("InvitationSender")
    receivedInvitations Invitation[]    @relation("InvitationReceiver")
    
    // Project memberships
    projectMemberships  ProjectMember[]
    addedProjectMembers ProjectMember[] @relation("ProjectMemberAdder")

    // Notifications
    sentNotifications     Notification[] @relation("NotificationSender")
    receivedNotifications Notification[] @relation("NotificationReceiver")
}

model Company {
    id                 String         @id @default(cuid())
    name               String         @unique
    shortName          String         @unique // For referral codes
    logo               String? // Company logo URL
    devReferralCode    String         @unique // For developer signup (legacy)
    clientReferralCode String         @unique // For client signup (legacy)
    productManagerId   String         @unique
    productManager     User           @relation("CompanyManager", fields: [productManagerId], references: [id])
    users              User[]         @relation("CompanyUsers")
    referralCodes      ReferralCode[] @relation("CompanyReferralCodes")
    invitations        Invitation[]   @relation("CompanyInvitations")
    createdAt          DateTime       @default(now())
    updatedAt          DateTime       @updatedAt

    @@map("companies")
}

model Team {
    id               String   @id @default(uuid())
    name             String
    productManagerId String   @unique
    productManager   User     @relation("TeamLead", fields: [productManagerId], references: [id])
    members          User[]   @relation("TeamMembers")
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
}

model Project {
    id             String          @id @default(cuid())
    title          String
    description    String?
    slug           String          @unique
    clientType     ClientType      @default(EXTERNAL)
    status         Status          @default(IN_PROGRESS)
    budget         Float
    currency       Currency        @default(USD)
    startDate      DateTime        @default(now())
    endDate        DateTime?
    // Payment tracking
    paidAmount     Float           @default(0)
    paymentStatus  String          @default("PENDING") // PENDING, PARTIAL, COMPLETED
    // Project links
    livePreviewUrl String?
    figmaUrl       String?
    githubUrl      String?
    documentsUrl   String?
    otherLinks     String?         @db.Text
    userId         String
    user           User            @relation(fields: [userId], references: [id])
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    tasks          Task[]
    feedbacks      Feedback[]
    messages       Message[]
    invitations    Invitation[]    @relation("ProjectInvitations")
    members        ProjectMember[]
}

model Task {
    id                  String     @id @default(uuid())
    title               String
    description         String?
    duration            Int?
    status              TaskStatus @default(YET_TO_START)
    projectId           String
    project             Project    @relation(fields: [projectId], references: [id])
    assignedDeveloperId String?
    assignedDeveloper   User?      @relation("AssignedDeveloper", fields: [assignedDeveloperId], references: [id])
    subtasks            SubTask[]
    createdAt           DateTime   @default(now())
    updatedAt           DateTime   @updatedAt
}

model SubTask {
    id          String   @id @default(uuid())
    title       String
    description String?
    completed   Boolean  @default(false)
    taskId      String
    task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Feedback {
    id          String         @id @default(uuid())
    title       String
    description String?
    status      FeedbackStatus @default(PENDING)
    userId      String
    user        User           @relation(fields: [userId], references: [id])
    projectId   String
    project     Project        @relation(fields: [projectId], references: [id])
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt
}

model Contact {
    id          String   @id @default(cuid())
    inquiryType String
    name        String
    email       String
    message     String   @db.Text
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([email])
}

model Account {
    id                String  @id @default(uuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@map("accounts")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
    id        String   @id @default(cuid())
    content   String   @db.Text
    imageUrl  String?  @db.Text
    linkUrl   String?  @db.Text
    linkTitle String?
    projectId String
    project   Project  @relation(fields: [projectId], references: [id])
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ReferralCode {
    id          String             @id @default(cuid())
    code        String             @unique
    role        Role // The role this referral code is for
    status      ReferralCodeStatus @default(ACTIVE)
    maxUses     Int                @default(1) // How many times this code can be used
    usedCount   Int                @default(0) // How many times it has been used
    expiresAt   DateTime? // Optional expiration date
    description String? // Optional description/note about the code

    // Who generated this code (should be a PRODUCTMANAGER)
    generatedById String
    generatedBy   User   @relation("GeneratedBy", fields: [generatedById], references: [id])

    // Company this code belongs to
    companyId String?
    company   Company? @relation("CompanyReferralCodes", fields: [companyId], references: [id])

    // Users who used this code
    usedBy User[] @relation("UsedBy")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([code])
    @@index([generatedById])
    @@index([status])
}

model Invitation {
    id        String           @id @default(cuid())
    email     String // Email of the person being invited
    type      InvitationType // COMPANY_MEMBER or PROJECT_MEMBER
    status    InvitationStatus @default(PENDING)
    message   String? // Optional message from sender
    expiresAt DateTime // When the invitation expires

    // Who sent the invitation (should be a PM or admin)
    senderId String
    sender   User   @relation("InvitationSender", fields: [senderId], references: [id])

    // Who received the invitation (may not exist yet if user not registered)
    receiverId String?
    receiver   User?   @relation("InvitationReceiver", fields: [receiverId], references: [id])

    // Company invitation is for
    companyId String?
    company   Company? @relation("CompanyInvitations", fields: [companyId], references: [id])

    // Project invitation is for (if type is PROJECT_MEMBER)
    projectId String?
    project   Project? @relation("ProjectInvitations", fields: [projectId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([email])
    @@index([senderId])
    @@index([status])
}

model ProjectMember {
    id       String   @id @default(cuid())
    role     String // "CLIENT", "DEVELOPER", "VIEWER", etc.
    joinedAt DateTime @default(now())

    // User and Project relation
    userId    String
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    projectId String
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    // Who added this member (usually a PM)
    addedById String?
    addedBy   User?   @relation("ProjectMemberAdder", fields: [addedById], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, projectId])
    @@index([userId])
    @@index([projectId])
}

model Notification {
    id          String           @id @default(cuid())
    title       String
    description String?          @db.Text
    type        NotificationType @default(GENERAL)
    read        Boolean          @default(false)
    actionUrl   String? // URL to redirect when notification is clicked
    metadata    Json? // Additional data related to notification

    // Who sent the notification
    senderId String?
    sender   User?  @relation("NotificationSender", fields: [senderId], references: [id])

    // Who receives the notification
    receiverId String
    receiver   User   @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([receiverId, read])
    @@index([receiverId, createdAt])
    @@index([type])
}