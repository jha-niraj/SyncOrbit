generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    COMPANY_OWNER
    TEAM_HEAD
    TEAM_MEMBER
    CLIENT
    ADMIN
}

enum TeamType {
    TECHNICAL
    MARKETING
    SALES
    DESIGN
    OPERATIONS
    FINANCE
    CUSTOM
}

enum ProjectVisibility {
    PUBLIC
    PRIVATE
}

enum Permission {
    VIEW_ALL_PROJECTS
    VIEW_TEAM_PROJECTS
    CREATE_PROJECTS
    EDIT_PROJECTS
    DELETE_PROJECTS

    CREATE_TASKS
    EDIT_TASKS
    DELETE_TASKS
    ASSIGN_TASKS

    INVITE_TEAM_MEMBERS
    REMOVE_TEAM_MEMBERS
    MANAGE_TEAM_SETTINGS
    VIEW_ANALYTICS
    VIEW_FINANCIAL_DATA
    GENERATE_REPORTS

    MANAGE_CLIENTS
    VIEW_CLIENT_DATA

    MANAGE_COMPANY_SETTINGS
    MANAGE_ROLES
    MANAGE_PERMISSIONS
}

enum Currency {
    USD
    INR
    NPR
}

enum TaskStatus {
    YET_TO_START
    IN_PROGRESS
    COMPLETED
}

enum Priority {
    LOW
    MEDIUM
    HIGH
    URGENT
}

enum Status {
    IN_PROGRESS
    COMPLETED
    ON_HOLD
    CANCELLED
}

enum ClientType {
    INTERNAL
    EXTERNAL
}

enum FeedbackStatus {
    PENDING
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum ReferralCodeStatus {
    ACTIVE
    USED
    EXPIRED
    DISABLED
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    DECLINED
    EXPIRED
}

enum InvitationType {
    TEAM_HEAD
    TEAM_MEMBER
    CLIENT
    PROJECT_MEMBER
}

enum NotificationType {
    PROJECT_ASSIGNED
    TASK_ASSIGNED
    TASK_COMPLETED
    PROJECT_UPDATE
    USER_PROMOTED
    CLIENT_ONBOARDED
    FEEDBACK_RECEIVED
    MENTION
    TEAM_INVITATION
    GENERAL
}

model User {
    id                String    @id @default(cuid())
    name              String?
    email             String?   @unique
    emailVerified     DateTime?
    hashedPassword    String?
    image             String?
    bio               String?   @db.Text
    skills            String?   @db.Text
    role              Role      @default(CLIENT)
    isActive          Boolean   @default(true)
    verifyToken       String?
    verifyTokenExpiry DateTime?
    resetToken        String?
    resetTokenExpiry  DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    totalSpent        Float     @default(0)

    // Location fields for invoices and payments
    address String? @db.Text
    city    String?
    state   String?
    country String?
    pincode String?

    // Dodo Payments customer ID
    dodoCustomerId String? @unique

    // Company relationship
    companyId    String?
    company      Company? @relation("CompanyUsers", fields: [companyId], references: [id])
    ownedCompany Company? @relation("CompanyOwner")

    // Team relationships
    teamMemberships TeamMember[]
    ledTeams        Team[]       @relation("TeamHead")

    roleAssignments RoleAssignment[]

    companyEmail String?
    referralCode String?

    generatedReferralCodes ReferralCode[] @relation("GeneratedBy")
    usedReferralCodeId     String?
    usedReferralCode       ReferralCode?  @relation("UsedBy", fields: [usedReferralCodeId], references: [id])

    // Relations
    projects      Project[]
    accounts      Account[]
    sessions      Session[]
    assignedTasks Task[]     @relation("AssignedDeveloper")
    feedbacks     Feedback[]
    messages      Message[]

    // Invitations
    sentInvitations     Invitation[] @relation("InvitationSender")
    receivedInvitations Invitation[] @relation("InvitationReceiver")

    // Project memberships
    projectMemberships  ProjectMember[]
    addedProjectMembers ProjectMember[] @relation("ProjectMemberAdder")

    // Team member relationships
    addedTeamMembers TeamMember[]     @relation("TeamMemberAdder")
    assignedRoles    RoleAssignment[] @relation("RoleAssigner")

    // Notifications
    sentNotifications     Notification[] @relation("NotificationSender")
    receivedNotifications Notification[] @relation("NotificationReceiver")

    // Project access for private projects
    invitedToProjects ProjectInvite[]

    // New team-related relations
    projectTeamAssignments ProjectTeam[]   @relation("ProjectTeamAssigner")
    projectInvitesSent     ProjectInvite[] @relation("ProjectInviter")
    createdTasks           Task[]          @relation("TaskCreator")

    // Subscription and payment relations
    subscriptions Subscription[]
    payments      Payment[]

    // Tools relations
    clientInvoices    Invoice[]        @relation("ClientInvoices")
    uploadedDocuments Document[]
    createdReports    Report[]
    invoiceMessages   InvoiceMessage[] @relation("InvoiceMessageSender")
    expenses          Expense[]        @relation("ExpenseCreator")
}

model Company {
    id          String  @id @default(cuid())
    name        String  @unique
    shortName   String  @unique
    logo        String? // Company logo URL
    description String? @db.Text
    website     String?
    address     String? @db.Text
    city        String?
    state       String?
    country     String?
    pincode     String?

    // Owner relationship (replaces productManager)
    ownerId String @unique
    owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])

    // Company users and structure
    users       User[]       @relation("CompanyUsers")
    teams       Team[]
    projects    Project[]
    invitations Invitation[]

    // Legacy fields (for backward compatibility)
    devReferralCode    String?        @unique // For developer signup (legacy)
    clientReferralCode String?        @unique // For client signup (legacy)
    referralCodes      ReferralCode[] @relation("CompanyReferralCodes")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Tools relations
    invoices          Invoice[]
    documents         Document[]
    knowledgeBases    KnowledgeBase[]   @relation("CompanyKnowledgeBase")
    reports           Report[]
    expenses          Expense[]
    expenseCategories ExpenseCategory[]

    @@map("companies")
}

model Expense {
    id          String   @id @default(cuid())
    description String
    amount      Float
    currency    Currency @default(USD)
    date        DateTime @default(now())
    category    String // SALARY, MAINTENANCE, DEVELOPMENT, etc.

    companyId String
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    creatorId String
    creator   User   @relation("ExpenseCreator", fields: [creatorId], references: [id])

    receiptUrl String? // Optional link to document

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([companyId])
    @@index([category])
}

model ExpenseCategory {
    id        String  @id @default(cuid())
    name      String
    companyId String
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    @@unique([companyId, name])
}

model Team {
    id          String   @id @default(cuid())
    name        String
    displayName String
    teamType    TeamType @default(CUSTOM)
    description String?  @db.Text
    color       String?
    isActive    Boolean  @default(true)

    companyId String
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    headId String? @unique
    head   User?   @relation("TeamHead", fields: [headId], references: [id])

    members          TeamMember[]
    roles            TeamRole[]
    assignedProjects ProjectTeam[]

    tasks Task[] @relation("TeamTasks")

    invitations Invitation[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([companyId, name])
}

model TeamMember {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    teamId String
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    roleTitle String
    isActive  Boolean @default(true)

    addedById String?
    addedBy   User?   @relation("TeamMemberAdder", fields: [addedById], references: [id])

    joinedAt  DateTime @default(now())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, teamId])
}

model TeamRole {
    id          String  @id @default(cuid())
    name        String
    description String? @db.Text

    teamId String
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    permissions RolePermission[]
    assignments RoleAssignment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([teamId, name])
}

model RoleAssignment {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    teamRoleId String
    teamRole   TeamRole @relation(fields: [teamRoleId], references: [id], onDelete: Cascade)

    assignedById String?
    assignedBy   User?   @relation("RoleAssigner", fields: [assignedById], references: [id])

    assignedAt DateTime @default(now())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([userId, teamRoleId])
}

model RolePermission {
    id String @id @default(cuid())

    teamRoleId String
    teamRole   TeamRole @relation(fields: [teamRoleId], references: [id], onDelete: Cascade)

    permission Permission

    createdAt DateTime @default(now())

    @@unique([teamRoleId, permission])
}

model Project {
    id          String     @id @default(cuid())
    title       String
    description String?
    slug        String     @unique
    clientType  ClientType @default(EXTERNAL)
    status      Status     @default(IN_PROGRESS)
    budget      Float
    currency    Currency   @default(USD)
    startDate   DateTime   @default(now())
    endDate     DateTime?

    paidAmount    Float  @default(0)
    paymentStatus String @default("PENDING")

    livePreviewUrl String?
    figmaUrl       String?
    githubUrl      String?
    documentsUrl   String?
    otherLinks     String? @db.Text

    visibility ProjectVisibility @default(PUBLIC)
    isArchived Boolean           @default(false)

    companyId String
    company   Company @relation(fields: [companyId], references: [id])

    userId String
    user   User   @relation(fields: [userId], references: [id])

    assignedTeams ProjectTeam[]

    projectInvites ProjectInvite[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tasks       Task[]
    feedbacks   Feedback[]
    messages    Message[]
    invitations Invitation[]    @relation("ProjectInvitations")
    members     ProjectMember[]
}

model ProjectTeam {
    id String @id @default(cuid())

    projectId String
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    teamId String
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    assignedById String?
    assignedBy   User?   @relation("ProjectTeamAssigner", fields: [assignedById], references: [id])

    assignedAt DateTime @default(now())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([projectId, teamId])
}

model ProjectInvite {
    id String @id @default(cuid())

    projectId String
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    invitedById String?
    invitedBy   User?   @relation("ProjectInviter", fields: [invitedById], references: [id])

    invitedAt DateTime @default(now())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([projectId, userId])
}

model Task {
    id          String     @id @default(uuid())
    title       String
    description String?
    duration    Int?
    status      TaskStatus @default(YET_TO_START)
    priority    Priority   @default(MEDIUM)
    startDate   DateTime?
    dueDate     DateTime?

    projectId String
    project   Project @relation(fields: [projectId], references: [id])

    assignedDeveloperId String?
    assignedDeveloper   User?   @relation("AssignedDeveloper", fields: [assignedDeveloperId], references: [id])

    assignedTeamId String?
    assignedTeam   Team?   @relation("TeamTasks", fields: [assignedTeamId], references: [id])

    createdById String?
    createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id])

    subtasks  SubTask[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}

model SubTask {
    id          String   @id @default(uuid())
    title       String
    description String?
    completed   Boolean  @default(false)
    taskId      String
    task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Feedback {
    id          String         @id @default(uuid())
    title       String
    description String?
    status      FeedbackStatus @default(PENDING)
    userId      String
    user        User           @relation(fields: [userId], references: [id])
    projectId   String
    project     Project        @relation(fields: [projectId], references: [id])
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt
}

model Contact {
    id          String   @id @default(cuid())
    inquiryType String
    name        String
    email       String
    message     String   @db.Text
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([email])
}

model Account {
    id                String  @id @default(uuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@map("accounts")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
    id        String   @id @default(cuid())
    content   String   @db.Text
    imageUrl  String?  @db.Text
    linkUrl   String?  @db.Text
    linkTitle String?
    projectId String
    project   Project  @relation(fields: [projectId], references: [id])
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ReferralCode {
    id          String             @id @default(cuid())
    code        String             @unique
    role        Role // The role this referral code is for
    status      ReferralCodeStatus @default(ACTIVE)
    maxUses     Int                @default(1)
    usedCount   Int                @default(0)
    expiresAt   DateTime?
    description String?

    generatedById String
    generatedBy   User   @relation("GeneratedBy", fields: [generatedById], references: [id])

    companyId String?
    company   Company? @relation("CompanyReferralCodes", fields: [companyId], references: [id])

    usedBy User[] @relation("UsedBy")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([code])
    @@index([generatedById])
    @@index([status])
}

model Invitation {
    id        String           @id @default(cuid())
    email     String
    type      InvitationType
    status    InvitationStatus @default(PENDING)
    message   String?
    expiresAt DateTime

    roleTitle String?
    teamId    String? // Which team they're being invited to
    team      Team?   @relation(fields: [teamId], references: [id])

    senderId String
    sender   User   @relation("InvitationSender", fields: [senderId], references: [id])

    receiverId String?
    receiver   User?   @relation("InvitationReceiver", fields: [receiverId], references: [id])

    companyId String?
    company   Company? @relation(fields: [companyId], references: [id])

    projectId String?
    project   Project? @relation("ProjectInvitations", fields: [projectId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([email])
    @@index([senderId])
    @@index([status])
    @@index([teamId])
}

model ProjectMember {
    id       String   @id @default(cuid())
    role     String
    joinedAt DateTime @default(now())

    userId    String
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    projectId String
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    addedById String?
    addedBy   User?   @relation("ProjectMemberAdder", fields: [addedById], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, projectId])
    @@index([userId])
    @@index([projectId])
}

model Notification {
    id          String           @id @default(cuid())
    title       String
    description String?          @db.Text
    type        NotificationType @default(GENERAL)
    read        Boolean          @default(false)
    actionUrl   String?
    metadata    Json?

    senderId   String?
    sender     User?   @relation("NotificationSender", fields: [senderId], references: [id])
    receiverId String
    receiver   User    @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([receiverId, read])
    @@index([receiverId, createdAt])
    @@index([type])
}

model Newsletter {
    id           String   @id @default(cuid())
    email        String   @unique
    subscribedAt DateTime @default(now())
    isActive     Boolean  @default(true)

    @@index([email])
    @@index([subscribedAt])
}

// Subscription Plans
enum SubscriptionPlan {
    FREE
    STARTER
    PROFESSIONAL
    ENTERPRISE
}

enum SubscriptionStatus {
    ACTIVE
    CANCELLED
    EXPIRED
    PAST_DUE
    TRIALING
}

enum PaymentStatus {
    PENDING
    PROCESSING
    SUCCEEDED
    FAILED
    REFUNDED
    CANCELLED
}

// Subscription model
model Subscription {
    id String @id @default(cuid())

    // User relationship
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Plan details
    plan   SubscriptionPlan   @default(FREE)
    status SubscriptionStatus @default(ACTIVE)

    // Dodo Payments IDs
    dodoSubscriptionId String? @unique
    dodoProductId      String?
    dodoPriceId        String?

    maxProjects    Int @default(3)
    maxTeams       Int @default(1)
    maxTeamMembers Int @default(5)
    maxStorage     Int @default(1)

    hasAdvancedAnalytics Boolean @default(false)
    hasPrioritySupport   Boolean @default(false)
    hasCustomBranding    Boolean @default(false)
    hasApiAccess         Boolean @default(false)

    amount       Float   @default(0)
    currency     String  @default("USD")
    billingCycle String?

    currentPeriodStart DateTime  @default(now())
    currentPeriodEnd   DateTime?
    trialStart         DateTime?
    trialEnd           DateTime?
    cancelledAt        DateTime?

    metadata Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    payments Payment[]

    @@index([userId])
    @@index([status])
    @@index([dodoSubscriptionId])
}

model Payment {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    subscriptionId String?
    subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

    dodoPaymentId         String? @unique
    dodoCheckoutSessionId String? @unique

    amount   Float
    currency String        @default("USD")
    status   PaymentStatus @default(PENDING)

    paymentMethod String?

    billingEmail String?
    billingName  String?
    description  String?
    metadata     Json?

    paidAt     DateTime?
    failedAt   DateTime?
    refundedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([subscriptionId])
    @@index([status])
    @@index([dodoPaymentId])
    @@index([dodoCheckoutSessionId])
}

// Invoice Management
enum InvoiceStatus {
    DRAFT
    SENT
    PAID
    OVERDUE
    CANCELLED
}

model Invoice {
    id            String        @id @default(cuid())
    invoiceNumber String        @unique
    amount        Float
    currency      Currency      @default(USD)
    status        InvoiceStatus @default(DRAFT)
    dueDate       DateTime
    issuedAt      DateTime      @default(now())
    paidAt        DateTime?

    companyId String
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    clientId String
    client   User   @relation("ClientInvoices", fields: [clientId], references: [id])

    items  Json
    pdfUrl String?

    notes     String?          @db.Text
    messages  InvoiceMessage[]
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt

    @@index([companyId])
    @@index([clientId])
}

model InvoiceMessage {
    id        String   @id @default(cuid())
    content   String   @db.Text
    invoiceId String
    invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    senderId  String
    sender    User     @relation("InvoiceMessageSender", fields: [senderId], references: [id])
    createdAt DateTime @default(now())

    @@index([invoiceId])
    @@index([senderId])
}

model Document {
    id          String  @id @default(cuid())
    title       String
    description String? @db.Text
    category    String  @default("GENERAL")
    fileUrl     String
    fileType    String
    size        Int?

    companyId String
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    uploaderId String
    uploader   User   @relation(fields: [uploaderId], references: [id])

    extractedText String? @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([companyId])
    @@index([uploaderId])
    @@index([category])
}

model KnowledgeBase {
    id        String  @id @default(cuid())
    companyId String
    company   Company @relation("CompanyKnowledgeBase", fields: [companyId], references: [id], onDelete: Cascade)

    date    String
    content String @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([companyId, date])
    @@index([companyId])
}

model Report {
    id    String @id @default(cuid())
    title String
    type  String
    data  Json

    companyId String
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    creatorId String
    creator   User   @relation(fields: [creatorId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([companyId])
}
